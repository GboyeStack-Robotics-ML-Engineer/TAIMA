{
  "name": "ai-task-manager",
  "version": "1.0.0",
  "description": "AI-powered time and task management app with screen capture and calendar integration",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"wait-on http://localhost:3001 && electron .\"",
    "dev:backend": "nodemon backend/server.js",
    "build": "electron-builder",
    "install:all": "npm install && cd backend && npm install"
  },
  "keywords": [
    "ai",
    "task-management",
    "calendar",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.0.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.2",
    "dotenv": "^17.2.3",
    "dompurify": "^3.0.9",
    "electron-store": "^8.1.0",
    "marked": "^9.1.6"
  }
}
